# ── SmartAgro Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the real .env file — it is already in .gitignore.

# ── Groq API Key ─────────────────────────────────────────────────────────────
# Powers the AI chatbot (Kisan Helper), crop disease vision analysis, and
# crop recommendations. Get a FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini API Key (optional) ─────────────────────────────────────────
# Adds a genuinely independent SECOND vision model to the crop-disease
# diagnosis ensemble (cross-model agreement = stronger confidence). Leave
# unset and diagnosis uses Groq only. Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Which Gemini model to use for diagnosis (default fine for low-cost vision)
GEMINI_DIAGNOSIS_MODEL=gemini-3.1-flash-lite

# ── OpenWeatherMap API Key ────────────────────────────────────────────────────
# Powers real-time current conditions and the free tier's ~5-6 day forecast.
# Get a FREE key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Visual Crossing API Key ────────────────────────────────────────────────────
# Powers the extended forecast (days beyond OpenWeatherMap's free ~5-6 day
# window, out to ~15 days total). Replaces the old Open-Meteo call, which
# kept coming back empty on Render's shared free-tier IP (its keyless quota
# is split across every app on that IP, not just this one).
# Get a FREE key at: https://www.visualcrossing.com/sign-up/
VISUALCROSSING_API_KEY=your_visualcrossing_api_key_here

# ── Data.gov.in API Key ───────────────────────────────────────────────────────
# Powers live mandi (market) prices for Indian commodities.
# Get a FREE key at: https://data.gov.in/user/register
DATA_GOV_API_KEY=your_data_gov_api_key_here

# ── Flask Debug Mode ──────────────────────────────────────────────────────────
# Set to 1 only in local development. ALWAYS keep 0 in production/HF Spaces.
FLASK_DEBUG=0

# ── Logging ───────────────────────────────────────────────────────────────────
# Severity threshold for structured logs: DEBUG | INFO | WARNING | ERROR.
# Defaults to INFO. NOTE: the app runs under a SINGLE gunicorn worker, so logs
# are consistent, but INFO can be chatty under load.
LOG_LEVEL=INFO

# ── Diagnosis QA audit logs (optional) ────────────────────────────────────────
# Where uploaded diagnosis images + the JSONL audit log are written. In local
# dev this defaults to ~/SmartAgro_Logs. On Hugging Face Spaces the container
# filesystem is EPHEMERAL — logs are wiped on every redeploy. Set this to a
# mounted/persistent path if you want to keep the accuracy audit trail.
#DIAGNOSIS_LOG_DIR=/persistent/smartagro_logs
