# Required for live weather and forecast data.
OPENWEATHER_API_KEY=
VISUALCROSSING_API_KEY=

# Groq powers crop recommendations, chatbot, voice transcription, and diagnosis fallback.
GROQ_API_KEY=

# Google AI API keys. Use the shared GEMINI_API_KEY as a fallback, or set
# separate keys for diagnosis and translation.
GEMINI_API_KEY=
GEMINI_API_KEY_DIAGNOSE=
GEMINI_API_KEY_TRANSLATE=
GEMINI_DIAGNOSIS_MODEL=gemini-3.6-flash
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash

# Optional Google Gemma diagnosis fallback.
GEMMA_API_KEY=
GEMMA_API_KEY_DIAGNOSE=
GEMMA_DIAGNOSIS_MODEL=gemma-3-27b-it

# Optional integrations.
DATA_GOV_API_KEY=
NINJA_API_KEY=
ADMIN_SECRET_KEY=
DIAGNOSIS_LOG_DIR=

# Local development options.
FLASK_DEBUG=0
LOG_LEVEL=INFO
